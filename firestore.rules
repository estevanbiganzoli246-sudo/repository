rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow get: if true;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) &&
                    incoming().uid == request.auth.uid &&
                    incoming().displayName is string && incoming().displayName.size() <= 120;
      allow update: if isSignedIn() && isValidId(userId) &&
                    (
                      isOwner(userId) ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followingCount'])
                    );
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Runs collection
    match /runs/{runId} {
      allow get: if isSignedIn() && isValidId(runId) &&
                 (
                   existing().userId == request.auth.uid ||
                   existing().visibility == 'public' ||
                   (existing().isPublic == true && !('visibility' in existing())) ||
                   (existing().visibility == 'followers' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + existing().userId)))
                 );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(runId) &&
                    incoming().userId == request.auth.uid &&
                    incoming().id == runId &&
                    incoming().distanceKm is number &&
                    incoming().durationSeconds is number;
      allow update: if isSignedIn() && isValidId(runId) &&
                    existing().userId == request.auth.uid &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(runId) &&
                    existing().userId == request.auth.uid;
    }

    // 3. Community Posts
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) &&
                 (
                   existing().userId == request.auth.uid ||
                   existing().visibility == 'public' ||
                   (!('visibility' in existing()) && true) ||
                   (existing().visibility == 'followers' && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + existing().userId)))
                 );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) &&
                    incoming().userId == request.auth.uid &&
                    incoming().id == postId;
      // Allow author to edit text/activity/visibility OR other signed in users to like/save
      allow update: if isSignedIn() && isValidId(postId) &&
                    (
                      existing().userId == request.auth.uid ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'commentsCount', 'savedBy'])
                    );
      allow delete: if isSignedIn() && isValidId(postId) &&
                    existing().userId == request.auth.uid;

      // Subcollection: comments
      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(commentId) &&
                      incoming().userId == request.auth.uid &&
                      incoming().postId == postId;
        allow delete: if isSignedIn() && isValidId(commentId) &&
                      (existing().userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // 4. Social Follows Graph
    match /follows/{followId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(followId) &&
                    incoming().followerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(followId) &&
                    existing().followerId == request.auth.uid;
    }

    // 5. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) &&
                 existing().recipientId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(notificationId) &&
                    incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(notificationId) &&
                    existing().recipientId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notificationId) &&
                    existing().recipientId == request.auth.uid;
    }
  }
}
