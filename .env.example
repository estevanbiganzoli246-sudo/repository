# MapTiler / OpenStreetMap Tile Provider API Key (Optional: leave blank for public OpenStreetMap / Carto tiles)
VITE_MAPTILER_KEY=

# Port for Web API Server (default: 3000)
PORT=3000

# Node Environment (production | development)
NODE_ENV=production

# Redis connection URL for distributed BullMQ queue (optional in standalone mode)
# Example: redis://default:password@redis-cloud-instance:6379 or rediss://... for Upstash/Render/Railway
REDIS_URL=

# Directory where temporary video clips are stored before user download
TEMP_DIR=/app/temp_clips

# Maximum age of temporary clips in milliseconds before automatic deletion (default: 3600000 = 1 hour)
TEMP_FILE_TTL_MS=3600000

# Concurrency for video processing worker
WORKER_CONCURRENCY=2

# Optional YouTube advanced authentication (leaves blank for public video downloads)
# Path to cookies.txt file or custom PO token if running on high-scrutiny datacenter networks
YOUTUBE_COOKIES_FILE=
YOUTUBE_PO_TOKEN=
